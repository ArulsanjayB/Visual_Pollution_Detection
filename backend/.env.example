# ═══════════════════════════════════════════════════════════════
# CivicLens Backend Configuration
# Copy this file to .env and edit if needed. Defaults are fine.
# ═══════════════════════════════════════════════════════════════

# Database: "local" = JSON file DB (no setup); "firebase" = Firestore
DATABASE_MODE=local

# Dev mode: accepts X-Dev-User header for passwordless auth
DEV_MODE=true

# Path to trained YOLOv8 weights (relative to backend/ directory)
# This path is auto-created when you run ml/train.py
MODEL_WEIGHTS_PATH=../ml/runs/visual_pollution_v1/weights/best.pt

# API server
API_HOST=0.0.0.0
API_PORT=8000

# CORS
CORS_ORIGINS=["*"]

# XAI defaults
DEFAULT_XAI_MODE=gradcam
LIME_SAMPLES=500

# Storage — images are saved to ./storage/ by default
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./storage

# Secrets
API_SECRET_KEY=dev_secret_key_change_in_production

# ── Firebase (optional, only if DATABASE_MODE=firebase) ─────
# FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com
